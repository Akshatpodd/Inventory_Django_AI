# Copy to .env and edit. Without DB_NAME the app uses SQLite (fine for trying it out).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (recommended for real use)
# DB_ENGINE=postgres
# DB_NAME=ims
# DB_USER=ims
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
